# ============================================================
# Fig6A
# Metabolomics PCA


# ------------------------------------------------------------
# 0. Packages
# ------------------------------------------------------------
library(dplyr)
library(ggplot2)
library(vegan)
library(grid)

# ============================================================
# Prepare age metadata
# ============================================================

meta_df <- age_df %>%
  dplyr::transmute(
    
    Sample =
      as.character(
        Sample
      ),
    
    Age =
      as.numeric(
        Age
      ),
    
    Group =
      dplyr::if_else(
        Age >= 90,
        "Longevity",
        "Non-longevity"
      )
  ) %>%
  
  dplyr::filter(
    !is.na(Sample),
    Sample != "",
    !is.na(Age)
  )

# ============================================================
# Convert metab_real
# ============================================================

metab_df <- as.data.frame(
  metab_real
)


# ------------------------------------------------------------
# Extract metabolite IDs
# ------------------------------------------------------------
metabolite_ids <- make.unique(
  as.character(
    metab_df$metab_id
  )
)


# ------------------------------------------------------------
# Remove metab_id column
# ------------------------------------------------------------
metab_numeric <- metab_df %>%
  dplyr::select(
    -metab_id
  )


# ------------------------------------------------------------
# Convert every sample column to numeric
# ------------------------------------------------------------
metab_numeric[] <- lapply(
  metab_numeric,
  as.numeric
)


# ------------------------------------------------------------
# Metabolites × Samples matrix
# ------------------------------------------------------------
metab_mat_raw <- as.matrix(
  metab_numeric
)

rownames(
  metab_mat_raw
) <- metabolite_ids


# ------------------------------------------------------------
# Samples × Metabolites
# ------------------------------------------------------------
metab_mat <- t(
  metab_mat_raw
)

mode(
  metab_mat
) <- "numeric"


cat(
  "\nOriginal metabolomics matrix:\n",
  "Samples =",
  nrow(metab_mat),
  "\nMetabolites =",
  ncol(metab_mat),
  "\n"
)


# ============================================================
# Match metabolomics samples with age metadata
# ============================================================

common_samples <- intersect(
  rownames(
    metab_mat
  ),
  meta_df$Sample
)


cat(
  "\nMatched samples =",
  length(
    common_samples
  ),
  "\n"
)


# ------------------------------------------------------------
# Show unmatched samples if any
# ------------------------------------------------------------
missing_in_age <- setdiff(
  rownames(
    metab_mat
  ),
  meta_df$Sample
)

missing_in_metab <- setdiff(
  meta_df$Sample,
  rownames(
    metab_mat
  )
)


if (
  length(
    missing_in_age
  ) > 0
) {
  
  cat(
    "\nSamples in metabolomics but not age_df:\n"
  )
  
  print(
    missing_in_age
  )
}


if (
  length(
    missing_in_metab
  ) > 0
) {
  
  cat(
    "\nSamples in age_df but not metabolomics:\n"
  )
  
  print(
    missing_in_metab
  )
}


# ============================================================
# Keep shared samples
# ============================================================

metab_mat <- metab_mat[
  common_samples,
  ,
  drop = FALSE
]


meta_df <- meta_df %>%
  dplyr::filter(
    Sample %in%
      common_samples
  ) %>%
  
  dplyr::arrange(
    match(
      Sample,
      rownames(
        metab_mat
      )
    )
  )


# ------------------------------------------------------------
# Confirm sample order
# ------------------------------------------------------------
stopifnot(
  all(
    meta_df$Sample ==
      rownames(
        metab_mat
      )
  )
)


# ------------------------------------------------------------
# Group order
# ------------------------------------------------------------
meta_df$Group <- factor(
  meta_df$Group,
  levels = c(
    "Non-longevity",
    "Longevity"
  )
)


cat(
  "\n================ Matched group counts ================\n"
)

print(
  meta_df %>%
    dplyr::count(
      Group
    )
)


# ============================================================
# Remove unusable metabolites
# ============================================================

# ------------------------------------------------------------
# Remove metabolites that are completely NA
# ------------------------------------------------------------
keep_non_na <- apply(
  metab_mat,
  2,
  function(x) {
    
    !all(
      is.na(
        x
      )
    )
  }
)

metab_mat <- metab_mat[
  ,
  keep_non_na,
  drop = FALSE
]


# ------------------------------------------------------------
# Fill occasional missing values with metabolite median
# ------------------------------------------------------------
for (
  j in seq_len(
    ncol(
      metab_mat
    )
  )
) {
  
  if (
    anyNA(
      metab_mat[, j]
    )
  ) {
    
    med_j <- median(
      metab_mat[, j],
      na.rm = TRUE
    )
    
    metab_mat[
      is.na(
        metab_mat[, j]
      ),
      j
    ] <- med_j
  }
}


# ------------------------------------------------------------
# Remove zero-variance metabolites
# PCA cannot scale zero-variance variables
# ------------------------------------------------------------
metab_sd <- apply(
  metab_mat,
  2,
  sd,
  na.rm = TRUE
)


keep_var <- is.finite(
  metab_sd
) &
  metab_sd > 0


metab_mat <- metab_mat[
  ,
  keep_var,
  drop = FALSE
]


cat(
  "\nFinal PCA matrix:\n",
  "Samples =",
  nrow(
    metab_mat
  ),
  "\nMetabolites =",
  ncol(
    metab_mat
  ),
  "\n"
)


# ============================================================
# PCA
# ============================================================

pca_res <- stats::prcomp(
  metab_mat,
  center = TRUE,
  scale. = TRUE
)


# ============================================================
# Explained variance
# ============================================================

pca_variance <- (
  pca_res$sdev^2 /
    sum(
      pca_res$sdev^2
    )
) * 100


PC1_var <- pca_variance[1]
PC2_var <- pca_variance[2]


axis1_lab <- paste0(
  "PC1 (",
  sprintf(
    "%.2f",
    PC1_var
  ),
  "%)"
)


axis2_lab <- paste0(
  "PC2 (",
  sprintf(
    "%.2f",
    PC2_var
  ),
  "%)"
)


cat(
  "\nPC1 explained variance =",
  sprintf(
    "%.2f",
    PC1_var
  ),
  "%\n"
)


cat(
  "PC2 explained variance =",
  sprintf(
    "%.2f",
    PC2_var
  ),
  "%\n"
)


# ============================================================
# PCA score table
# ============================================================

plot_df <- data.frame(
  
  Sample =
    rownames(
      pca_res$x
    ),
  
  PC1 =
    pca_res$x[, 1],
  
  PC2 =
    pca_res$x[, 2],
  
  stringsAsFactors =
    FALSE
)


plot_df <- plot_df %>%
  
  dplyr::left_join(
    
    meta_df %>%
      dplyr::select(
        Sample,
        Age,
        Group
      ),
    
    by =
      "Sample"
  )


plot_df$Group <- factor(
  plot_df$Group,
  levels = c(
    "Non-longevity",
    "Longevity"
  )
)


# ============================================================
# PERMANOVA
# ============================================================

metab_scaled <- scale(
  metab_mat,
  center = TRUE,
  scale = TRUE
)


metab_dist <- stats::dist(
  metab_scaled,
  method = "euclidean"
)


set.seed(
  123
)


adonis_res <- vegan::adonis2(
  metab_dist ~ Group,
  data = meta_df,
  permutations = 999
)


cat(
  "\n================ PERMANOVA ================\n"
)

print(
  adonis_res
)


R2_value <- adonis_res$R2[1]

P_value <- adonis_res$`Pr(>F)`[1]


# ------------------------------------------------------------
# Annotation text
# ------------------------------------------------------------
r2_text <- paste0(
  "PERMANOVA R² = ",
  sprintf(
    "%.3f",
    R2_value
  )
)


p_text <- ifelse(
  
  P_value < 0.001,
  
  "P < 0.001",
  
  paste0(
    "P = ",
    sprintf(
      "%.3f",
      P_value
    )
  )
)


# ============================================================
# Colors
# ============================================================

col_longevity <- "#4F8F83"

col_nonlongev <- "#D9A34A"


# ============================================================
# PCA plot
# ============================================================

p_pca <- ggplot(
  
  plot_df,
  
  aes(
    x = PC1,
    y = PC2,
    color = Group,
    fill = Group
  )
  
) +
  
  # ----------------------------------------------------------
# 95% ellipse
# ----------------------------------------------------------
stat_ellipse(
  geom = "polygon",
  type = "norm",
  level = 0.95,
  alpha = 0.18,
  linewidth = 0.9
) +
  
  # ----------------------------------------------------------
# Sample points
# ----------------------------------------------------------
geom_point(
  size = 3.2,
  alpha = 0.90
) +
  
  # ----------------------------------------------------------
# Colors
# ----------------------------------------------------------
scale_color_manual(
  values = c(
    "Non-longevity" =
      col_nonlongev,
    
    "Longevity" =
      col_longevity
  )
) +
  
  scale_fill_manual(
    values = c(
      "Non-longevity" =
        col_nonlongev,
      
      "Longevity" =
        col_longevity
    )
  ) +
  
  # ----------------------------------------------------------
# PERMANOVA annotation
# ----------------------------------------------------------
annotate(
  "text",
  
  x = Inf,
  y = Inf,
  
  label = paste0(
    r2_text,
    "\n",
    p_text
  ),
  
  hjust = 1.05,
  vjust = 1.10,
  
  family = "Arial",
  fontface = "bold",
  size = 5.2,
  color = "black"
) +
  
  # ----------------------------------------------------------
# PCA labels
# ----------------------------------------------------------
labs(
  x = axis1_lab,
  y = axis2_lab,
  color = NULL,
  fill = NULL
) +
  
  # ----------------------------------------------------------
# Theme
# ----------------------------------------------------------
theme_classic(
  base_family = "Arial"
) +
  
  theme(
    
    text = element_text(
      family = "Arial",
      color = "black"
    ),
    
    # --------------------------------------------------------
    # White background
    # --------------------------------------------------------
    panel.background = element_rect(
      fill = "white",
      color = NA
    ),
    
    plot.background = element_rect(
      fill = "white",
      color = NA
    ),
    
    # --------------------------------------------------------
    # Axis titles
    # --------------------------------------------------------
    axis.title.x = element_text(
      family = "Arial",
      size = 18,
      face = "bold",
      color = "black",
      margin = margin(
        t = 8
      )
    ),
    
    axis.title.y = element_text(
      family = "Arial",
      size = 18,
      face = "bold",
      color = "black",
      margin = margin(
        r = 8
      )
    ),
    
    # --------------------------------------------------------
    # Axis tick labels
    # --------------------------------------------------------
    axis.text.x = element_text(
      family = "Arial",
      size = 13,
      face = "bold",
      color = "black"
    ),
    
    axis.text.y = element_text(
      family = "Arial",
      size = 13,
      face = "bold",
      color = "black"
    ),
    
    # --------------------------------------------------------
    # Four-sided border
    # --------------------------------------------------------
    axis.line = element_blank(),
    
    panel.border = element_rect(
      color = "black",
      fill = NA,
      linewidth = 1.5
    ),
    
    axis.ticks = element_line(
      linewidth = 1.1,
      color = "black"
    ),
    
    axis.ticks.length = grid::unit(
      0.17,
      "cm"
    ),
    
    # --------------------------------------------------------
    # Legend upper-left
    # --------------------------------------------------------
    legend.position = c(
      0.02,
      0.98
    ),
    
    legend.justification = c(
      0,
      1
    ),
    
    legend.title = element_blank(),
    
    legend.text = element_text(
      family = "Arial",
      size = 13,
      face = "bold",
      color = "black"
    ),
    
    legend.background = element_rect(
      fill = "white",
      color = NA
    ),
    
    legend.key = element_rect(
      fill = "white",
      color = NA
    ),
    
    legend.key.width = grid::unit(
      0.55,
      "cm"
    ),
    
    legend.key.height = grid::unit(
      0.55,
      "cm"
    ),
    
    legend.spacing.y = grid::unit(
      0.05,
      "cm"
    ),
    
    # --------------------------------------------------------
    # Square-ish plot
    # --------------------------------------------------------
    aspect.ratio = 1,
    
    # --------------------------------------------------------
    # Margin
    # --------------------------------------------------------
    plot.margin = margin(
      t = 10,
      r = 12,
      b = 10,
      l = 10
    )
  )


# ============================================================
# Preview
# ============================================================

print(
  p_pca
)


# ============================================================
# Export PCA result table
# Optional but useful for archive
# ============================================================

write.csv(
  plot_df,
  "C:/Users/Administrator/Desktop/Fig5A_PCA_scores.csv",
  row.names = FALSE
)


# ============================================================
#Export PDF
#
# NO showtext
# Cairo PDF
# Arial editable text
# ============================================================

pdf_file <- paste0(
  "C:/Users/Administrator/Desktop/",
  "Fig5A_metabolomics_PCA_FINAL.pdf"
)


if (
  file.exists(
    pdf_file
  )
) {
  
  file.remove(
    pdf_file
  )
}


grDevices::cairo_pdf(
  filename = pdf_file,
  width = 6.5,
  height = 6,
  family = "Arial"
)


print(
  p_pca
)


