# alpha-KG
col_alpha <- "#B85C5C"

# Edge colors
col_edge_pos <- "#AFCFCA"
col_edge_neg <- "#E7C4A8"


# ============================================================
# Plot
# ============================================================

p_net <- ggraph::ggraph(
  lay
) +
  
  # ----------------------------------------------------------
# Edges
# ----------------------------------------------------------
ggraph::geom_edge_link(
  
  aes(
    edge_width =
      abs_rho,
    
    edge_color =
      sign
  ),
  
  alpha =
    0.50,
  
  lineend =
    "round",
  
  show.legend =
    TRUE
) +
  
  # ----------------------------------------------------------
# Ordinary nodes
# ----------------------------------------------------------
ggraph::geom_node_point(
  
  aes(
    size =
      node_size,
    
    fill =
      Direction_plot
  ),
  
  shape =
    21,
  
  color =
    "white",
  
  stroke =
    0.5
) +
  
  # ----------------------------------------------------------
# alpha-KG overlay
# red outline
# ----------------------------------------------------------
ggraph::geom_node_point(
  
  data =
    lay %>%
    filter(
      Metabolite ==
        "Oxoglutaric acid"
