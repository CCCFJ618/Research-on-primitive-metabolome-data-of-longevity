    col_alpha,
  
  stroke =
    1.6,
  
  show.legend =
    FALSE
) +
  
  # ----------------------------------------------------------
# alpha-KG label
#
# IMPORTANT:
# Arial
# ordinary geom_text
# NO showtext
# ----------------------------------------------------------
geom_text(
  
  data =
    lay %>%
    filter(
      Metabolite ==
        "Oxoglutaric acid"
    ),
  
  aes(
    x =
      x +
      0.225,
    
    y =
      y +
      0.020,
    
    label =
      "Oxoglutaric acid"
  ),
  
  color =
    col_alpha,
  
  family =
    "Arial",
  
  fontface =
    "bold",
  
  size =
    5.4,
  
  hjust =
    0,
  
  vjust =
    0.5
) +
  
  # ==========================================================
# Node colors
# ==========================================================
scale_fill_manual(
  
  name =
    NULL,
  
  values =
    c(
      "Up" =
        col_up,
      
      "Down" =
        col_down,
      
      "Other" =
