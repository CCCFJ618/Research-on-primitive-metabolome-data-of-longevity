      "Up",
      "Down",
      "Other"
    ),
  
  labels =
    c(
      "Up",
      "Down",
      "Other"
    )
) +
  
  # ==========================================================
# Edge colors
# ==========================================================
ggraph::scale_edge_color_manual(
  
  name =
    "Correlation",
  
  values =
    c(
      "Positive" =
        col_edge_pos,
      
      "Negative" =
        col_edge_neg
    )
) +
  
  # ----------------------------------------------------------
# Edge width
# ----------------------------------------------------------
ggraph::scale_edge_width(
  
  range =
    c(
      0.35,
      1.8
    ),
  
  guide =
    "none"
) +
  
  # ----------------------------------------------------------
# Node size already calculated
# ----------------------------------------------------------
scale_size_identity(
  guide =
    "none"
) +
  
  # ==========================================================
# Theme
# ==========================================================
theme_void(
  base_family =
    "Arial"
) +
  
  theme(
    
    text =
      element_text(
        family =
          "Arial",
        color =
          "black"
      ),
    
    plot.background =
      element_rect(
        fill =
          "white",
        color =
          NA
      ),
    
    panel.background =
      element_rect(
        fill =
          "white",
        color =
          NA
      ),
    
    # --------------------------------------------------------
    # Legend
    # --------------------------------------------------------
    legend.position =
      "right",
    
    legend.title =
      element_text(
        family =
          "Arial",
        face =
          "bold",
        size =
          12,
        color =
          "black"
      ),
    
    legend.text =
      element_text(
        family =
          "Arial",
        face =
          "bold",
        size =
          11,
        color =
          "black"
      ),
    
    legend.key =
      element_rect(
