# ============================================================
# Fig.5A FINAL ARCHIVE VERSION
# Bifidobacterium adolescentis ATCC 15703
#
# Circular genome map highlighting GH13-related CAZymes
# ============================================================


# ------------------------------------------------------------
# 0. Clear environment
# ------------------------------------------------------------
rm(list = ls())


# ------------------------------------------------------------
# 1. Packages
# ------------------------------------------------------------
library(dplyr)
library(stringr)
library(readr)
library(Biostrings)
library(circlize)


# ------------------------------------------------------------
# 2. Make sure showtext is OFF
# ------------------------------------------------------------
if ("showtext" %in% loadedNamespaces()) {
  showtext::showtext_auto(FALSE)
}


# ------------------------------------------------------------
# 3. Input files
# ------------------------------------------------------------
gff_file <- paste0(
  "D:/肾病切片/ncbi_dataset/data/",
  "GCF_000010425.1/genomic.gff"
)

fna_file <- paste0(
  "D:/肾病切片/ncbi_dataset/data/",
  "GCF_000010425.1/",
  "GCF_000010425.1_ASM1042v1_genomic.fna"
)


# ------------------------------------------------------------
# 4. Read GFF
# ------------------------------------------------------------
gff <- readr::read_tsv(
  gff_file,
  comment = "#",
  col_names = c(
    "seqid",
    "source",
    "type",
    "start",
    "end",
    "score",
    "strand",
    "phase",
    "attributes"
  ),
  show_col_types = FALSE
)


# ------------------------------------------------------------
# 5. Genome information
# ------------------------------------------------------------
genome_region <- gff %>%
  dplyr::filter(type == "region") %>%
  dplyr::slice(1)

genome_id <- genome_region$seqid[1]

genome_start <- as.numeric(
  genome_region$start[1]
)

genome_end <- as.numeric(
  genome_region$end[1]
)

genome_length <-
  genome_end -
  genome_start +
  1

cat(
  "Genome ID:",
  genome_id,
  "\n"
)

cat(
  "Genome length:",
  genome_length,
  "bp\n"
)


# ------------------------------------------------------------
# 6. Extract CDS information
# ------------------------------------------------------------
cds <- gff %>%
  dplyr::filter(type == "CDS") %>%
  dplyr::mutate(
    
    protein_id =
      stringr::str_extract(
        attributes,
        "protein_id=[^;]+"
      ),
    
    protein_id =
      stringr::str_remove(
        protein_id,
        "protein_id="
      ),
    
    gene =
      stringr::str_extract(
        attributes,
        "gene=[^;]+"
      ),
    
    gene =
      stringr::str_remove(
        gene,
        "gene="
      ),
    
    locus_tag =
      stringr::str_extract(
        attributes,
        "locus_tag=[^;]+"
      ),
    
    locus_tag =
      stringr::str_remove(
        locus_tag,
        "locus_tag="
      ),
    
    product =
      stringr::str_extract(
        attributes,
        "product=[^;]+"
      ),
    
    product =
      stringr::str_remove(
        product,
        "product="
      ),
    
    start =
      as.numeric(start),
    
    end =
      as.numeric(end)
  )


# ------------------------------------------------------------
# 7. Forward / Reverse CDS
# ------------------------------------------------------------
cds_forward <- cds %>%
  dplyr::filter(
    strand == "+"
  )

cds_reverse <- cds %>%
  dplyr::filter(
    strand == "-"
  )


# ============================================================
# 8. GH13 annotation
# Based on dbCAN results
# ============================================================
gh13_info <- tibble::tibble(
  
  protein_id = c(
    "WP_011742626.1",
    "WP_011743089.1",
    "WP_011743102.1",
    "WP_011743122.1",
    "WP_011743123.1",
    "WP_011743335.1",
    "WP_011743857.1",
    "WP_011743867.1",
    "WP_050731445.1"
  ),
  
  family = c(
    "GH13_18",
    "GH13_9",
    "GH13_11",
    "GH13_32",
    "GH13_32 / GH13_14",
    "GH13_30",
    "GH13_14",
    "GH13_31",
    "GH13_30"
  ),
  
  substrate = c(
    "Sucrose",
    "Alpha-glucan",
    "Alpha-glucan",
    "Alpha-glucan",
    "Alpha-glucan",
    "Alpha-glucan",
    "Alpha-glucan",
    "Alpha-glucan / Sucrose",
    "Alpha-glucan"
  )
)


# ------------------------------------------------------------
# 9. Match GH13 proteins to genome coordinates
# ------------------------------------------------------------
gh13_genes <- cds %>%
  dplyr::inner_join(
    gh13_info,
    by = "protein_id"
  ) %>%
  dplyr::arrange(start)


# ------------------------------------------------------------
# 10. Check matching
# ------------------------------------------------------------
print(
  gh13_genes %>%
    dplyr::select(
      protein_id,
      family,
      substrate,
      start,
      end,
      strand,
      locus_tag,
      product
    )
)


# ============================================================
# 11. Color palette
# ============================================================

col_backbone <- "#D5D5D5"

col_gh13 <- "#3F73B9"
col_sucrose <- "#C65A5A"

col_forward <- "#4F4F4F"
col_reverse <- "#B8B8B8"

col_gc_pos <- "#8A6F5A"
col_gc_neg <- "#D8CEC6"

col_skew_pos <- "#788A99"
col_skew_neg <- "#D4DDE3"


# ============================================================
# 12. Prepare GH13 marker positions
# ============================================================
gh13_genes <- gh13_genes %>%
  dplyr::mutate(
    
    gene_color =
      dplyr::if_else(
        protein_id ==
          "WP_011742626.1",
        col_sucrose,
        col_gh13
      ),
    
    marker_start =
      dplyr::if_else(
        
        protein_id ==
          "WP_011742626.1",
        
        pmax(
          start - 12000,
          genome_start
        ),
        
        pmax(
          start - 7000,
          genome_start
        )
      ),
    
    marker_end =
      dplyr::if_else(
        
        protein_id ==
          "WP_011742626.1",
        
        pmin(
          end + 12000,
          genome_end
        ),
        
        pmin(
          end + 7000,
          genome_end
        )
      ),
    
    mid =
      (
        start +
          end
      ) / 2
  )


# ============================================================
# 13. GH13 label text
# ============================================================
gh13_genes <- gh13_genes %>%
  dplyr::mutate(
    
    plot_label =
      dplyr::case_when(
        
        protein_id ==
          "WP_011742626.1" ~
          "GH13_18\nSucrose phosphorylase",
        
        protein_id ==
          "WP_011743123.1" ~
          "GH13_32 /\nGH13_14",
        
        TRUE ~
          family
      )
  )


