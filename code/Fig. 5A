                df_tmp$label_x[i],
              
              y =
                df_tmp$label_y[i],
              
              labels =
                df_tmp$plot_label[i],
              
              facing =
                "clockwise",
              
              niceFacing =
                TRUE,
              
              adj =
                c(
                  0,
                  0.5
