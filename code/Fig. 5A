      "WP_011742626.1"
    
    circlize::circos.rect(
      
      xleft =
        df$marker_start[i],
      
      ybottom =
        ifelse(
          is_sucrose,
          0.04,
          0.10
        ),
      
      xright =
        df$marker_end[i],
      
      ytop =
        ifelse(
          is_sucrose,
          0.96,
          0.90
        ),
      
      col =
        df$gene_color[i],
      
      border =
        ifelse(
          is_sucrose,
          "#873E3E",
          NA
        ),
      
      lwd =
        ifelse(
          is_sucrose,
          1.3,
          0.5
        )
    )
  }
}


