# 14. FINAL label positions
# ============================================================
gh13_genes <- gh13_genes %>%
  dplyr::mutate(
    
    label_x =
      dplyr::case_when(
        
        protein_id ==
          "WP_011742626.1" ~
          mid,
        
        protein_id ==
