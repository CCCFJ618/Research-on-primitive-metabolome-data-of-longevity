          mid - 125000,
        
        protein_id ==
          "WP_011743102.1" ~
          mid - 55000,
        
        protein_id ==
          "WP_011743122.1" ~
          mid + 45000,
        
        protein_id ==
          "WP_011743123.1" ~
          mid + 130000,
        
        protein_id ==
          "WP_011743335.1" ~
          mid,
        
        protein_id ==
          "WP_011743857.1" ~
          mid - 25000,
        
        protein_id ==
          "WP_011743867.1" ~
          mid + 30000,
        
        protein_id ==
          "WP_050731445.1" ~
          mid,
        
        TRUE ~
          mid
      ),
    
    label_x =
      pmax(
        genome_start,
        pmin(
          label_x,
          genome_end
        )
      ),
    
    label_y =
      dplyr::case_when(
        
        protein_id ==
          "WP_011742626.1" ~
          1.25,
        
        protein_id ==
          "WP_011743089.1" ~
          1.16,
        
        protein_id ==
          "WP_011743102.1" ~
          1.29,
        
        protein_id ==
          "WP_011743122.1" ~
          1.17,
        
        protein_id ==
          "WP_011743123.1" ~
          1.31,
        
        protein_id ==
          "WP_011743335.1" ~
          1.13,
        
        protein_id ==
          "WP_011743857.1" ~
          1.13,
        
        protein_id ==
          "WP_011743867.1" ~
          1.26,
        
        protein_id ==
          "WP_050731445.1" ~
          1.15,
        
        TRUE ~
          1.15
      )
  )


# ============================================================
# 15. Read genome FASTA
# ============================================================
dna <- Biostrings::readDNAStringSet(
  fna_file
)

seq_chr <- dna[[1]]

cat(
  "FASTA length:",
  length(seq_chr),
  "\n"
)


# ------------------------------------------------------------
# 16. Check genome length
# ------------------------------------------------------------
if (
  length(seq_chr) !=
  genome_length
) {
  
  warning(
    paste0(
      "FASTA length = ",
      length(seq_chr),
      "; GFF length = ",
      genome_length
    )
  )
}


# ============================================================
# 17. Calculate GC content and GC skew
# ============================================================

window_size <- 20000
step_size <- 10000

starts <- seq(
  from = 1,
  to =
    genome_length -
    window_size +
    1,
  by = step_size
)

gc_list <- lapply(
  
  starts,
  
  function(st) {
    
    en <-
      min(
        st +
          window_size -
          1,
        genome_length
      )
    
    fragment <-
      Biostrings::subseq(
        seq_chr,
        start = st,
        end = en
      )
    
    counts <-
      Biostrings::alphabetFrequency(
        fragment,
        baseOnly = TRUE
      )
    
    A <- as.numeric(counts["A"])
    C <- as.numeric(counts["C"])
    G <- as.numeric(counts["G"])
    T <- as.numeric(counts["T"])
    
    total <-
      A +
      C +
      G +
      T
    
    gc_content <-
      ifelse(
        total == 0,
        NA,
        (G + C) /
          total
      )
    
    gc_skew <-
      ifelse(
        (G + C) == 0,
        0,
        (G - C) /
          (G + C)
      )
    
    data.frame(
      
      start = st,
      
      end = en,
      
      mid =
        (
          st +
            en
        ) / 2,
      
      gc_content =
        gc_content,
      
      gc_skew =
        gc_skew
    )
  }
)

gc_df <-
  dplyr::bind_rows(
    gc_list
  )


# ------------------------------------------------------------
# 18. Center GC content
# ------------------------------------------------------------
mean_gc <- mean(
  gc_df$gc_content,
  na.rm = TRUE
)

gc_df <- gc_df %>%
  dplyr::mutate(
    gc_centered =
      gc_content -
      mean_gc
  )


# ------------------------------------------------------------
# 19. Rescale helper
# ------------------------------------------------------------
rescale01 <- function(x) {
  
  r <- range(
    x,
    na.rm = TRUE
  )
  
  if (
    !all(is.finite(r)) ||
    diff(r) == 0
  ) {
    
    return(
      rep(
        0.5,
        length(x)
      )
    )
  }
  
  (
    x -
      r[1]
  ) /
    diff(r)
}


gc_df <- gc_df %>%
  dplyr::mutate(
    
    gc_scaled =
      rescale01(
        gc_centered
      ),
    
    skew_scaled =
      rescale01(
        gc_skew
      )
  )


# ============================================================
# 20. CDS drawing helper
# ============================================================
draw_cds_track <- function(
    df,
    fill_col
) {
  
  if (
    nrow(df) ==
    0
  ) {
    
    return(
      invisible(NULL)
    )
  }
  
  for (
    i in seq_len(
      nrow(df)
    )
  ) {
    
    circlize::circos.rect(
      
      xleft =
        df$start[i],
      
      ybottom =
        0.13,
      
      xright =
        df$end[i],
      
      ytop =
        0.87,
      
      col =
        fill_col,
      
      border =
        NA
    )
  }
}


