# ------------------------------------------------------------
# 9. Plot function
# ------------------------------------------------------------
make_rank_plot <- function(
    df,
    title_text
) {
  
  ggplot(
    df,
    aes(
      x = rho,
      y = ypos
    )
  ) +
    
    # --------------------------------------------------------
  # Other stems
  # --------------------------------------------------------
  geom_segment(
    data = df %>%
      filter(
        !is_target
      ),
    
    aes(
      x = 0,
      xend = rho,
      y = ypos,
      yend = ypos
    ),
    
    color = col_other,
    linewidth = 1.15,
    lineend = "round"
  ) +
    
    # --------------------------------------------------------
  # Target stem
  # --------------------------------------------------------
  geom_segment(
    data = df %>%
      filter(
        is_target
      ),
    
    aes(
      x = 0,
      xend = rho,
      y = ypos,
      yend = ypos
    ),
    
    color = col_target,
    linewidth = 1.45,
    lineend = "round"
  ) +
    
    # --------------------------------------------------------
  # Other points
  # --------------------------------------------------------
  geom_point(
    data = df %>%
      filter(
        !is_target
      ),
    
    color = col_other,
    size = 3.2
  ) +
    
    # --------------------------------------------------------
  # Target point
  # --------------------------------------------------------
  geom_point(
    data = df %>%
      filter(
        is_target
      ),
    
    color = col_target,
    size = 4.3
  ) +
    
    # --------------------------------------------------------
  # Other rho values
  # --------------------------------------------------------
  geom_text(
    data = df %>%
      filter(
        !is_target
      ),
    
    aes(
      label = sprintf(
        "%.3f",
        rho
      )
    ),
    
    hjust = -0.15,
    family = "Arial",
    fontface = "bold",
    size = 2.8,
    color = col_other
  ) +
    
    # --------------------------------------------------------
  # Target rho + rank
  # --------------------------------------------------------
  geom_text(
    data = df %>%
      filter(
        is_target
      ),
    
    aes(
      label = paste0(
        sprintf(
          "%.3f",
          rho
        ),
        "  (#",
        rank_rho,
        ")"
      )
    ),
    
    hjust = -0.15,
    family = "Arial",
    fontface = "bold",
    size = 3.0,
    color = col_target
  ) +
    
    # --------------------------------------------------------
  # X axis
  #
  # Extra space added on right
  # --------------------------------------------------------
  scale_x_continuous(
    limits = c(
      0,
      x_right
    ),
    
    expand = expansion(
      mult = c(
        0,
        0
      )
    )
  ) +
    
    # --------------------------------------------------------
  # Y axis
  #
  # IMPORTANT:
  # Keep original top/bottom blank space.
  # Do NOT change this again.
  # --------------------------------------------------------
  scale_y_continuous(
    breaks = df$ypos,
    labels = df$Species_label,
    
    expand = expansion(
      mult = c(
        0.03,
        0.03
      )
    )
  ) +
    
    # --------------------------------------------------------
  # Prevent numeric labels from being clipped
  # --------------------------------------------------------
  coord_cartesian(
    clip = "off"
  ) +
    
    # --------------------------------------------------------
  # Labels
  # --------------------------------------------------------
  labs(
    title = title_text,
    x = "Spearman rho",
    y = NULL
  ) +
    
    # --------------------------------------------------------
  # Theme
  # --------------------------------------------------------
  theme_classic(
    base_family = "Arial"
  ) +
    
    theme(
      
      text = element_text(
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      plot.title = element_text(
        family = "Arial",
        size = 18,
        face = "bold",
        hjust = 0.5,
        margin = margin(
          b = 8
        )
      ),
      
      axis.title.x = element_text(
        family = "Arial",
        size = 14,
        face = "bold",
        margin = margin(
          t = 8
        )
      ),
      
      axis.text.x = element_text(
        family = "Arial",
        size = 11,
        face = "bold",
        color = "black"
      ),
      
      # ======================================================
      # IMPORTANT:
      # Plain element_text
      # NO ggtext
      #
      # This is necessary for editable PDF text
      # ======================================================
      axis.text.y = element_text(
        family = "Arial",
        size = 10.5,
        face = "bold",
        color = "black"
      ),
      
      axis.line = element_blank(),
      
      axis.ticks = element_line(
        color = "black",
        linewidth = 0.9
      ),
      
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 1.4
      ),
      
      # Enough room for labels/value text
      plot.margin = margin(
        t = 8,
        r = 38,
        b = 8,
        l = 8
      )
    )
}

