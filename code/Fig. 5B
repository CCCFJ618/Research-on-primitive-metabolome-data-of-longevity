)

df_28_raw <- read_excel(
  file_path,
  sheet = "GH13_28"
)

df_39_raw <- read_excel(
  file_path,
  sheet = "GH13_39"
)

# ------------------------------------------------------------
# 4. Clean function
# ------------------------------------------------------------
clean_rank_data <- function(df, family_name) {
  
  df %>%
    mutate(
      Family = as.character(Family),
      Species = as.character(Species),
      n = as.numeric(n),
      rho = as.numeric(rho),
      p = as.numeric(p),
      FDR = as.numeric(FDR),
      rank_rho = as.numeric(rank_rho),
      total_species = as.numeric(total_species),
      rho_percentile = as.numeric(rho_percentile),
      Family_plot = family_name
    ) %>%
    filter(
      !is.na(Species),
      Species != "",
      !is.na(rho),
      !is.na(rank_rho)
    )
}

df_18 <- clean_rank_data(
  df_18_raw,
  "GH13_18"
)

df_28 <- clean_rank_data(
  df_28_raw,
  "GH13_28"
)

df_39 <- clean_rank_data(
  df_39_raw,
  "GH13_39"
)

# ------------------------------------------------------------
# 5. TRUE Top10
# ------------------------------------------------------------
prepare_top10 <- function(df) {
  
  out <- df %>%
    
    # TRUE rank order
    arrange(rank_rho) %>%
    
    # Top10
    slice_head(
      n = top_n
    ) %>%
    
    mutate(
      is_target =
        Species == target_species,
      
      # IMPORTANT:
      # plain text only
      # NO HTML / NO ggtext
      Species_label =
        Species
    )
  
  # rank 1 at top
  out <- out %>%
    mutate(
      row_id = row_number(),
      ypos = rev(
        seq_len(
          n()
        )
      )
    )
  
  return(out)
}

# ------------------------------------------------------------
# 6. Prepare Top10
# ------------------------------------------------------------
plot_18 <- prepare_top10(
  df_18
)

plot_28 <- prepare_top10(
  df_28
)

plot_39 <- prepare_top10(
  df_39
)

