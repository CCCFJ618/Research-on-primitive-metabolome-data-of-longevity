# ============================================================
# Random Forest species importance
# Hainan / Sardinia / Emilia Romagna
# TRUE Top5
# ============================================================

library(readxl)
library(dplyr)
library(ggplot2)
library(patchwork)
library(ggtext)
library(grid)

# ------------------------------------------------------------
#  File path
# ------------------------------------------------------------
rf_file <- paste0(
  "C:/Users/Administrator/Desktop/长寿老人/长寿老人/",
  "老人-宏基因组/地区之间的比较—确定年龄分组/",
  "RF结果.xlsx"
)

# ------------------------------------------------------------
# Read sheets
# ------------------------------------------------------------
rf_hainan <- read_excel(
  rf_file,
  sheet = "Hainan_rank"
)

rf_sardinia <- read_excel(
  rf_file,
  sheet = "Sardinia_rank"
)

rf_emilia <- read_excel(
  rf_file,
  sheet = "Emilia_rank"
)

# ------------------------------------------------------------
#  Parameters
# ------------------------------------------------------------
target_species <- "Bifidobacterium.adolescentis"

col_normal <- "#8E8E8E"
col_target <- "#B85C5C"

col_num_normal <- "black"
col_num_target <- "#B85C5C"

# 每个地区只保留前5
top_n <- 5

# ------------------------------------------------------------
#  Prepare function
# ------------------------------------------------------------
prepare_rf <- function(df, top_n = 5) {
  
  df <- df %>%
    mutate(
      Test_region = as.character(Test_region),
      Species = as.character(Species),
      Rank = as.numeric(Rank),
      MeanDecreaseGini = as.numeric(MeanDecreaseGini)
    ) %>%
    filter(
      !is.na(Species),
      Species != "",
      !is.na(MeanDecreaseGini)
    ) %>%
    arrange(desc(MeanDecreaseGini))
  
  # 真正的前5
  top_df <- df %>%
    slice_head(n = top_n)
  
  # 是否高亮青春双歧杆菌
  top_df <- top_df %>%
    mutate(
      Highlight = ifelse(
        Species == target_species,
        "Target",
        "Other"
      ),
      
      Species_display = ifelse(
        Species == target_species,
        paste0(
          "<span style='color:", col_target, ";'>",
          Species,
          "</span>"
        ),
        Species
      )
    ) %>%
    arrange(MeanDecreaseGini) %>%
    mutate(
      Species_display = factor(
        Species_display,
        levels = Species_display
      )
    )
  
  return(top_df)
}

# ------------------------------------------------------------
# Prepare data
# ------------------------------------------------------------
hainan_top <- prepare_rf(rf_hainan, top_n)
sardinia_top <- prepare_rf(rf_sardinia, top_n)
emilia_top <- prepare_rf(rf_emilia, top_n)

# ------------------------------------------------------------
# Check final Top5 species
# ------------------------------------------------------------
cat("\n================ Hainan Top5 ================\n")
print(
  hainan_top %>%
    select(Species, MeanDecreaseGini),
  n = Inf
)

cat("\n================ Sardinia Top5 ================\n")
print(
  sardinia_top %>%
    select(Species, MeanDecreaseGini),
  n = Inf
)

cat("\n================ Emilia Romagna Top5 ================\n")
print(
  emilia_top %>%
    select(Species, MeanDecreaseGini),
  n = Inf
)

cat(
  "\nNumber of species:\n",
  "Hainan =", nrow(hainan_top), "\n",
  "Sardinia =", nrow(sardinia_top), "\n",
  "Emilia =", nrow(emilia_top), "\n"
)

# ------------------------------------------------------------
#  Plot function
# ------------------------------------------------------------
make_rf_plot <- function(df, title_text) {
  
  xmax <- max(df$MeanDecreaseGini, na.rm = TRUE) * 1.22
  
  ggplot(
    df,
    aes(
      x = MeanDecreaseGini,
      y = Species_display
    )
  ) +
    
    # 棒棒糖线
    geom_segment(
      aes(
        x = 0,
        xend = MeanDecreaseGini,
        y = Species_display,
        yend = Species_display,
        color = Highlight
      ),
      linewidth = 1.5,
      alpha = 0.95
    ) +
    
    # 圆点
    geom_point(
      aes(color = Highlight),
      size = 4.2
    ) +
    
    # 普通菌数值
    geom_text(
      data = df %>%
        filter(Highlight == "Other"),
      aes(
        label = sprintf("%.2f", MeanDecreaseGini)
      ),
      hjust = -0.32,
      size = 4.2,
      family = "Arial",
      fontface = "bold",
      color = col_num_normal,
      show.legend = FALSE
    ) +
    
    # 目标菌数值（如果它在Top5里）
    geom_text(
      data = df %>%
        filter(Highlight == "Target"),
      aes(
        label = sprintf("%.2f", MeanDecreaseGini)
      ),
      hjust = -0.32,
      size = 4.25,
      family = "Arial",
      fontface = "bold",
      color = col_num_target,
      show.legend = FALSE
    ) +
    
    scale_color_manual(
      values = c(
        "Other" = col_normal,
        "Target" = col_target
      ),
      guide = "none"
    ) +
    
    scale_x_continuous(
      limits = c(0, xmax),
      expand = expansion(mult = c(0, 0))
    ) +
    
    coord_cartesian(clip = "off") +
    
    labs(
      title = title_text,
      x = "Mean Decrease Gini",
      y = NULL
    ) +
    
    theme_classic(base_family = "Arial") +
    
    theme(
      text = element_text(
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      plot.title = element_text(
        size = 20,
        hjust = 0.5,
        margin = margin(b = 10)
      ),
      
      axis.title.x = element_text(
        size = 16,
        margin = margin(t = 10)
      ),
      
      axis.text.x = element_text(
        size = 12,
        color = "black"
      ),
      
      axis.text.y = ggtext::element_markdown(
        size = 11,
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      axis.line = element_blank(),
      
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 1.5
      ),
      
      axis.ticks = element_line(
        color = "black",
        linewidth = 1
      ),
      
      plot.margin = margin(10, 28, 10, 10)
    )
}

# ------------------------------------------------------------
# Draw plots
# ------------------------------------------------------------
p_rf_H <- make_rf_plot(hainan_top, "Hainan")
p_rf_S <- make_rf_plot(sardinia_top, "Sardinia")
p_rf_E <- make_rf_plot(emilia_top, "Emilia Romagna")

# ------------------------------------------------------------
# 10. Combine
# ------------------------------------------------------------
p <- p_rf_H + p_rf_S + p_rf_E +
  plot_layout(ncol = 3)

# Show
p

# ------------------------------------------------------------
# 11. Export PDF
# ------------------------------------------------------------
ggsave(
  filename = "C:/Users/Administrator/Desktop/Fig3F_RF_importance_Top5_no_manual_delete.pdf",
  plot = p,
  width = 16,
  height = 7,
  units = "in",
  device = cairo_pdf,
