library(readxl)
library(dplyr)
library(ggplot2)


# ============================================================
# 读取数据
# ============================================================

file <- "C:/Users/Administrator/Desktop/长寿老人/长寿老人/老人-外显子组/5genes_CADD_REVEL_summary.xlsx"

df <- read_excel(file)

# ============================================================
# Fig E
# ============================================================

dat_e <- df %>%
  transmute(
    Gene = Gene.refGene,
    n_variants = as.numeric(n_variants)
  ) %>%
  mutate(
    Highlight = ifelse(Gene == "SI", "SI", "Other")
  ) %>%
  arrange(n_variants) %>%
  mutate(
    Gene = factor(Gene, levels = Gene)
  )

si_e <- dat_e %>% filter(Gene == "SI")
non_si_e <- dat_e %>% filter(Gene != "SI")

cols_gene <- c(
  "Other" = "#4F8F83",
  "SI" = "#B85C5C"
)

p_e <- ggplot(
  dat_e,
  aes(
    x = n_variants,
    y = Gene,
    fill = Highlight
  )
) +
  
  geom_col(
    width = 0.58
  ) +
  
  # 非SI数字：黑色
  geom_text(
    data = non_si_e,
    aes(label = n_variants),
    hjust = -0.18,
    family = "Arial",
    fontface = "bold",
    size = 5,
    color = "black"
  ) +
  
  # SI数字：砖红色
  geom_text(
    data = si_e,
    aes(label = n_variants),
    hjust = -0.18,
    family = "Arial",
    fontface = "bold",
    size = 5,
    color = "#B85C5C"
  ) +
  
  scale_fill_manual(
    values = cols_gene
  ) +
  
  scale_x_continuous(
    breaks = 0:6,
    expand = expansion(
      mult = c(0, 0.12)
    )
  ) +
  
  labs(
    x = "Number of variants",
    y = NULL
  ) +
  
  theme_classic(
    base_family = "Arial",
    base_size = 12
  ) +
  
  theme(
    
    aspect.ratio = 1,
    
    axis.line = element_blank(),
    
    panel.border = element_rect(
      color = "black",
      fill = NA,
      linewidth = 1.5
    ),
    
    axis.title.x = element_text(
      family = "Arial",
      face = "bold",
      size = 16,
      color = "black"
    ),
    
    axis.text.x = element_text(
      family = "Arial",
      face = "bold",
      size = 13,
      color = "black"
    ),
    
    axis.text.y = element_text(
      family = "Arial",
      face = "bold",
      size = 14,
      color = "black"
    ),
    
    axis.ticks = element_line(
      linewidth = 1,
      color = "black"
    ),
    
    legend.position = "none"
  )

p_e


