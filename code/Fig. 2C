# ============================================================
# Fig G
# ============================================================

dat_g <- df %>%
  transmute(
    Gene = Gene.refGene,
    mean_REVEL_raw = as.numeric(mean_REVEL)
  ) %>%
  mutate(
    
    mean_REVEL_plot = ifelse(
      is.na(mean_REVEL_raw),
      0,
      mean_REVEL_raw
    ),
    
    label_text = ifelse(
      is.na(mean_REVEL_raw),
      "NA",
      sprintf("%.3f", mean_REVEL_raw)
    ),
    
    Highlight = ifelse(
      Gene == "SI",
      "SI",
      "Other"
    )
    
  ) %>%
  arrange(mean_REVEL_plot) %>%
  mutate(
    Gene = factor(
      Gene,
      levels = Gene
    )
  )

si_g <- dat_g %>% filter(Gene == "SI")
non_si_g <- dat_g %>% filter(Gene != "SI")

p_g <- ggplot(
  dat_g,
  aes(
    x = mean_REVEL_plot,
    y = Gene,
    fill = Highlight
  )
) +
  
  geom_col(
    width = 0.58
  ) +
  
  # 非SI数字：黑色
  geom_text(
    data = non_si_g,
    aes(label = label_text),
    hjust = -0.15,
    family = "Arial",
    fontface = "bold",
    size = 4.8,
    color = "black"
  ) +
  
  # SI数字：砖红色
  geom_text(
    data = si_g,
    aes(label = label_text),
    hjust = -0.15,
    family = "Arial",
    fontface = "bold",
    size = 4.8,
    color = "#B85C5C"
  ) +
  
  scale_fill_manual(
    values = cols_gene
  ) +
  
  scale_x_continuous(
    limits = c(0, 0.80),
    breaks = seq(0, 0.75, 0.15),
    expand = expansion(
      mult = c(0, 0.08)
    )
  ) +
  
  labs(
    x = "Mean REVEL score",
    y = NULL
  ) +
  
  theme_classic(
    base_family = "Arial",
    base_size = 12
  ) +
  
  theme(
    
    aspect.ratio = 1,
    
    axis.line = element_blank(),
    
    panel.border = element_rect(
      color = "black",
      fill = NA,
      linewidth = 1.5
    ),
    
    axis.title.x = element_text(
