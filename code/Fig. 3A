# ============================================================
# Fig.3A CAZy Volcano Plot
# Longevity vs Non-longevity
# Final version - Arial
# Editable text for Illustrator
# ============================================================

library(readxl)
library(dplyr)
library(ggplot2)
library(ggrepel)
library(grid)


# ------------------------------------------------------------
# 1. Input file
# ------------------------------------------------------------
file <- "C:/Users/Administrator/Desktop/长寿老人/长寿老人/老人-外显子组/CAZy_longevity_vs_nonlongevity_with_prevalence.xlsx"

df <- read_excel(
  file,
  sheet = 1
)

# 检查列名
print(colnames(df))

# ------------------------------------------------------------
# 2. Data cleaning
# ------------------------------------------------------------
df <- df %>%
  mutate(
    Family = as.character(Family),
    mean_longevity = as.numeric(mean_longevity),
    mean_non_longevity = as.numeric(mean_non_longevity),
    p = as.numeric(p),
    FDR = as.numeric(FDR)
  )

# ------------------------------------------------------------
# 3. Pseudocount
# 使用两组所有非零平均丰度中的最小值 / 2
# ------------------------------------------------------------
all_nonzero <- c(
  df$mean_longevity[df$mean_longevity > 0],
  df$mean_non_longevity[df$mean_non_longevity > 0]
)

pseudo <- min(
  all_nonzero,
  na.rm = TRUE
) / 2

cat(
  "Pseudocount =",
  pseudo,
  "\n"
)

# ------------------------------------------------------------
# 4. Calculate log2FC and -log10(P)
#
# log2FC > 0:
#   enriched in Longevity
#
# log2FC < 0:
#   enriched in Non-longevity
#
# Differential threshold:
#   nominal P < 0.05
# ------------------------------------------------------------
df <- df %>%
  mutate(
    log2FC = log2(
      (mean_longevity + pseudo) /
        (mean_non_longevity + pseudo)
    ),
    
    neglog10P = -log10(p),
    
    Group = case_when(
      p < 0.05 & log2FC > 0 ~ "Longevity",
      p < 0.05 & log2FC < 0 ~ "Non-longevity",
      TRUE ~ "NS"
    )
  )

# ------------------------------------------------------------
# 5. Target CAZy families
# ------------------------------------------------------------
target_family <- c(
  "GH13_18",
  "GH13_28",
  "GH13_39"
)

label_df <- df %>%
  filter(
    Family %in% target_family
  )

# 打印重点 family 数据，便于核对
print(
  label_df %>%
    select(
      Family,
      mean_longevity,
      mean_non_longevity,
      log2FC,
      p,
      FDR,
      Group
    )
)

# ------------------------------------------------------------
# 6. Colors
# ------------------------------------------------------------

# 分组配色
cols <- c(
  "Non-longevity" = "#D9A66F",
  "Longevity" = "#4F8F83",
  "NS" = "#C8C8C8"
)

# GH13 高亮色
highlight_red <- "#B85C5C"

# ------------------------------------------------------------
# 8. Volcano plot
# ------------------------------------------------------------
p_volcano <- ggplot(
  df,
  aes(
    x = log2FC,
    y = neglog10P,
    color = Group
  )
) +
  
  # ----------------------------------------------------------
# Scatter points
# ----------------------------------------------------------
geom_point(
  size = 3.2,
  alpha = 0.88
) +
  
  # ----------------------------------------------------------
# Threshold/reference lines
# ----------------------------------------------------------

# P = 0.05
geom_hline(
  yintercept = -log10(0.05),
  linetype = "dashed",
  linewidth = 0.75,
  color = "#777777"
) +
  
  # log2FC = 0
  geom_vline(
    xintercept = 0,
    linetype = "dashed",
    linewidth = 0.75,
    color = "#777777"
  ) +
  
  # ----------------------------------------------------------
# Highlight GH13 families
# ----------------------------------------------------------
geom_label_repel(
  data = label_df,
  aes(
    label = Family
  ),
  
  family = "Arial",
  fontface = "bold",
  
  # 标签文字大小
  size = 4.8,
  
  # 红色文字
  color = highlight_red,
  
  # 白色背景
  fill = "white",
  
  # 标签避让
  box.padding = 0.55,
  point.padding = 0.40,
  
  # 红色标签边框
  label.size = 0.60,
  
  # 标签圆角
  label.r = unit(
    0.12,
    "lines"
  ),
  
  # 标签内部留白
  label.padding = unit(
    0.20,
    "lines"
  ),
  
  # 红色连接线
  segment.color = highlight_red,
  segment.size = 0.65,
  
  min.segment.length = 0,
  
  max.overlaps = Inf,
  
  show.legend = FALSE
) +
  
  # ----------------------------------------------------------
# Manual colors
# ----------------------------------------------------------
scale_color_manual(
  values = cols,
  
  # Legend order
  breaks = c(
    "Non-longevity",
    "Longevity",
    "NS"
  )
) +
  
  # ----------------------------------------------------------
# Axis titles
# ----------------------------------------------------------
labs(
  x = expression(
    log[2]~"(Longevity / Non-longevity)"
  ),
  
  y = expression(
    -log[10]~"(P value)"
  ),
  
  color = NULL
) +
  
  # ----------------------------------------------------------
# Theme
# ----------------------------------------------------------
theme_classic(
  base_family = "Arial"
) +
  
  theme(
    
    # --------------------------------------------------------
    # Overall text
    # --------------------------------------------------------
    text = element_text(
      family = "Arial",
      face = "bold",
      color = "black"
    ),
    
    # --------------------------------------------------------
    # X axis title
    # --------------------------------------------------------
    axis.title.x = element_text(
      size = 17,
      face = "bold",
      margin = margin(
        t = 10
      )
    ),
    
    # --------------------------------------------------------
    # Y axis title
    # --------------------------------------------------------
    axis.title.y = element_text(
      size = 17,
      face = "bold",
      margin = margin(
        r = 10
      )
    ),
    
    # --------------------------------------------------------
    # Axis tick labels
    # --------------------------------------------------------
    axis.text = element_text(
      size = 14,
      face = "bold",
      color = "black"
    ),
    
    # --------------------------------------------------------
    # IMPORTANT:
    # Do NOT draw axis.line separately
    #
    # Otherwise bottom/left will overlap with panel.border
    # and appear thicker than top/right.
    # --------------------------------------------------------
    axis.line = element_blank(),
    
    # --------------------------------------------------------
    # Axis ticks
    # --------------------------------------------------------
    axis.ticks = element_line(
      linewidth = 1,
      color = "black"
    ),
    
    axis.ticks.length = unit(
      0.18,
      "cm"
    ),
    
    # --------------------------------------------------------
    # Legend
    # --------------------------------------------------------
    legend.position = c(
      0.82,
      0.90
    ),
    
    legend.text = element_text(
      size = 12.5,
      face = "bold"
    ),
    
    legend.key = element_blank(),
    
    # --------------------------------------------------------
    # Unified four-side border
    # --------------------------------------------------------
    panel.border = element_rect(
      color = "black",
      fill = NA,
      linewidth = 1.5
    ),
    
    # --------------------------------------------------------
    # Square plot
    # --------------------------------------------------------
    aspect.ratio = 1,
    
    # --------------------------------------------------------
    # Plot margins
    # --------------------------------------------------------
    plot.margin = margin(
      t = 10,
      r = 12,
      b = 10,
      l = 10
    )
  )

# ------------------------------------------------------------
# 9. Show plot
# ------------------------------------------------------------
p_volcano

# ------------------------------------------------------------
# 10. 导出为 PDF
#     Cairo PDF
#     不经过 showtext
# ------------------------------------------------------------
ggsave(
  filename = "C:/Users/Administrator/Desktop/Fig2B_CAZy_volcano.pdf",
  plot = p_volcano,
  width = 6.5,
  height = 6.5,
  device = cairo_pdf
)
