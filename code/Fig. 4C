# Numeric label colors
col_num_normal <- "black"
col_num_target <- "#B85C5C"

# Final number of species per panel
top_n <- 10

# ------------------------------------------------------------
# Species manually removed
#

# ------------------------------------------------------------
# Prepare function
# ------------------------------------------------------------
prepare_rf <- function(
    df,
    top_n = 10
) {
  
  # ----------------------------------------------------------
  # Basic cleaning
  # ----------------------------------------------------------
  df <- df %>%
    mutate(
      Test_region = as.character(Test_region),
      Species = as.character(Species),
      Rank = as.numeric(Rank),
      MeanDecreaseGini = as.numeric(MeanDecreaseGini)
    ) %>%
    filter(
      !is.na(Species),
      Species != "",
      !is.na(MeanDecreaseGini)
    )
  
  # ----------------------------------------------------------
  # Manually remove selected species
  # ----------------------------------------------------------
  df <- df %>%
    filter(
      !Species %in% manual_remove_species
    )
  
  # ----------------------------------------------------------
  # Rank by MeanDecreaseGini
  # ----------------------------------------------------------
  df <- df %>%
    arrange(
      desc(MeanDecreaseGini)
    )
  
  # ----------------------------------------------------------
  # Select Top10
  # ----------------------------------------------------------
  top_df <- df %>%
    slice_head(
      n = top_n
    )
  
  # ----------------------------------------------------------
  # Find B. adolescentis
  # ----------------------------------------------------------
  ba_row <- df %>%
    filter(
      Species == target_species
    )
  
  # ----------------------------------------------------------
  # If B. adolescentis is not in Top10:
  # keep Top9 + B. adolescentis
  #
  # Final number remains 10
  # ----------------------------------------------------------
  if (
    nrow(ba_row) > 0 &&
    !(target_species %in% top_df$Species)
  ) {
    
    top_df <- bind_rows(
      df %>%
        slice_head(
          n = top_n - 1
        ),
      ba_row
    ) %>%
      distinct(
        Species,
        .keep_all = TRUE
      )
  }
  
  # ----------------------------------------------------------
  # Highlight target species
  # ----------------------------------------------------------
  top_df <- top_df %>%
    mutate(
      
      Highlight = ifelse(
        Species == target_species,
        "Target",
        "Other"
      ),
      
      Species_display = ifelse(
        Species == target_species,
        paste0(
          "<span style='color:",
          col_target,
          ";'>",
          Species,
          "</span>"
        ),
        Species
      )
      
    ) %>%
    
    # Small value at bottom,
    # large value at top
    arrange(
      MeanDecreaseGini
    ) %>%
    
    mutate(
      Species_display = factor(
        Species_display,
        levels = Species_display
      )
    )
  
  return(top_df)
}

