# ------------------------------------------------------------
# Plot function
# ------------------------------------------------------------
make_rf_plot <- function(
    df,
    title_text
) {
  
  # 给右边数字留空间
  xmax <- max(
    df$MeanDecreaseGini,
    na.rm = TRUE
  ) * 1.22
  
  ggplot(
    df,
    aes(
      x = MeanDecreaseGini,
      y = Species_display
    )
  ) +
    
    # --------------------------------------------------------
  # Lollipop segments
  # --------------------------------------------------------
  geom_segment(
    aes(
      x = 0,
      xend = MeanDecreaseGini,
      y = Species_display,
      yend = Species_display,
      color = Highlight
    ),
    linewidth = 1.5,
    alpha = 0.95
  ) +
    
    # --------------------------------------------------------
  # Points
  # --------------------------------------------------------
  geom_point(
    aes(
      color = Highlight
    ),
    size = 4.2
  ) +
    
    # --------------------------------------------------------
  # Normal species values
  # --------------------------------------------------------
  geom_text(
    data = df %>%
      filter(
        Highlight == "Other"
      ),
    aes(
      label = sprintf(
        "%.2f",
        MeanDecreaseGini
      )
    ),
    hjust = -0.32,
    size = 4.2,
    family = "Arial",
    fontface = "bold",
    color = col_num_normal,
    show.legend = FALSE
  ) +
    
    # --------------------------------------------------------
  # B. adolescentis value
  # --------------------------------------------------------
  geom_text(
    data = df %>%
      filter(
        Highlight == "Target"
      ),
    aes(
      label = sprintf(
        "%.2f",
        MeanDecreaseGini
      )
    ),
    hjust = -0.32,
    size = 4.25,
    family = "Arial",
    fontface = "bold",
    color = col_num_target,
    show.legend = FALSE
  ) +
    
    # --------------------------------------------------------
  # Colors
  # --------------------------------------------------------
  scale_color_manual(
    values = c(
      "Other" = col_normal,
      "Target" = col_target
    ),
    guide = "none"
  ) +
    
    # --------------------------------------------------------
  # X axis
  # --------------------------------------------------------
  scale_x_continuous(
    limits = c(
      0,
      xmax
    ),
    expand = expansion(
      mult = c(
        0,
        0
      )
    )
  ) +
    
    coord_cartesian(
      clip = "off"
    ) +
    
    # --------------------------------------------------------
  # Labels
  # --------------------------------------------------------
  labs(
    title = title_text,
    x = "Mean Decrease Gini",
    y = NULL
  ) +
    
    # --------------------------------------------------------
  # Theme
  # --------------------------------------------------------
  theme_classic(
    base_family = "Arial"
  ) +
    
    theme(
      
      text = element_text(
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      plot.title = element_text(
        size = 20,
        hjust = 0.5,
        margin = margin(
          b = 10
        )
      ),
      
      axis.title.x = element_text(
        size = 16,
        margin = margin(
          t = 10
        )
      ),
      
      axis.text.x = element_text(
        size = 12,
        color = "black"
      ),
      
      axis.text.y = ggtext::element_markdown(
        size = 11,
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      axis.line = element_blank(),
      
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 1.5
      ),
      
      axis.ticks = element_line(
        color = "black",
        linewidth = 1
      ),
      
      plot.margin = margin(
        10,
        28,
        10,
        10
      )
    )
}

