# ============================================================
# MaAsLin2 Top10 forest plot
# Left : Longevity vs Young
# Right: Longevity vs Middle
# Green  = Longevity-enriched
# Yellow = Non-longevity-enriched
# Grey   = NS
# ============================================================

library(readxl)
library(dplyr)
library(ggplot2)
library(patchwork)
library(grid)

# ------------------------------------------------------------
# File path
# ------------------------------------------------------------
maaslin_file <- paste0(
  "C:/Users/Administrator/Desktop/",
  "长寿老人/长寿老人/老人-宏基因组/",
  "地区之间的比较—确定年龄分组/",
  "MaAsLin2年龄分组.xlsx"
)

# ------------------------------------------------------------
# Parameters
# ------------------------------------------------------------
top_n <- 10

target_species <- "Bifidobacterium adolescentis"

# Colors
col_longevity <- "#4F8F83"
col_nonlongev <- "#D8A15B"
col_ns        <- "#9E9E9E"
col_target    <- "#B85C5C"

group_levels <- c(
  "Longevity-enriched",
  "Non-longevity-enriched",
  "NS"
)

# ------------------------------------------------------------
# Read data
# ------------------------------------------------------------
df_young_raw <- read_excel(
  maaslin_file,
  sheet = "Longevity_vs_Young"
)

df_middle_raw <- read_excel(
  maaslin_file,
  sheet = "Longevity_vs_Middle"
)

# ------------------------------------------------------------
# Clean function
# ------------------------------------------------------------
clean_maaslin <- function(df, comparison_name) {
  
  df %>%
    mutate(
      feature = as.character(feature),
      metadata = as.character(metadata),
      value = as.character(value),
      
      coef = as.numeric(coef),
      stderr = as.numeric(stderr),
      
      N = as.numeric(N),
      N.not.0 = as.numeric(N.not.0),
      
      pval = as.numeric(pval),
      
      qval = suppressWarnings(
        as.numeric(qval)
      ),
      
      coef_longevity = as.numeric(
        coef_longevity
      ),
      
      comparison = comparison_name,
      
      Species = gsub(
        "\\.",
        " ",
        feature
      ),
      
      # 95% confidence interval
      CI_low =
        coef_longevity -
        1.96 * stderr,
      
      CI_high =
        coef_longevity +
        1.96 * stderr,
      
      group = case_when(
        
        !is.na(pval) &
          pval < 0.05 &
          coef_longevity > 0 ~
          "Longevity-enriched",
        
        !is.na(pval) &
          pval < 0.05 &
          coef_longevity < 0 ~
          "Non-longevity-enriched",
        
        TRUE ~
          "NS"
      ),
      
      group = factor(
        group,
        levels = group_levels
      )
    ) %>%
    
    filter(
      !is.na(Species),
      Species != "",
      !is.na(coef_longevity),
      !is.na(stderr),
      !is.na(pval)
    )
}

# ------------------------------------------------------------
# Clean both comparisons
# ------------------------------------------------------------
df_young <- clean_maaslin(
  df_young_raw,
  "Longevity vs Young"
)

df_middle <- clean_maaslin(
  df_middle_raw,
  "Longevity vs Middle"
)

# ------------------------------------------------------------
# Select TRUE Top10 by absolute coefficient
# ------------------------------------------------------------
get_top10 <- function(df, top_n = 10) {
  
  df %>%
    arrange(
      desc(
        abs(coef_longevity)
      )
    ) %>%
    
    slice_head(
      n = top_n
    ) %>%
    
    arrange(
      coef_longevity
    ) %>%
    
    mutate(
      Species_label = Species,
      
      Species_label = factor(
        Species_label,
        levels = Species_label
      ),
      
      group = factor(
        group,
        levels = group_levels
      ),
      
      target = ifelse(
        Species == target_species,
        "Target",
        "Other"
      )
    )
}

# ------------------------------------------------------------
# Prepare plotting data
# ------------------------------------------------------------
plot_young <- get_top10(
  df_young,
  top_n
)

plot_middle <- get_top10(
  df_middle,
  top_n
)

