# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------
my_cols <- c(
  "Longevity-enriched" = col_longevity,
  "Non-longevity-enriched" = col_nonlongev,
  "NS" = col_ns
)

# ------------------------------------------------------------
# Forest plot function
# ------------------------------------------------------------
make_forest_plot <- function(df, title_text) {
  
  ggplot(
    df,
    aes(
      x = coef_longevity,
      y = Species_label
    )
  ) +
    
    # --------------------------------------------------------
  # Zero reference line
  # --------------------------------------------------------
  geom_vline(
    xintercept = 0,
    linetype = "dashed",
    linewidth = 0.8,
    color = "#666666"
  ) +
    
    # --------------------------------------------------------
  # 95% CI
  # --------------------------------------------------------
  geom_segment(
    aes(
      x = CI_low,
      xend = CI_high,
      y = Species_label,
      yend = Species_label,
      color = group
    ),
    linewidth = 1.35,
    alpha = 0.95,
    show.legend = FALSE
  ) +
    
    # --------------------------------------------------------
  # Coefficient points
  # --------------------------------------------------------
  geom_point(
    aes(
      color = group
    ),
    size = 4,
    alpha = 1,
    show.legend = TRUE
  ) +
    
    # --------------------------------------------------------
  # Extra red outline for B. adolescentis
  # if naturally present in Top10
  # --------------------------------------------------------
  geom_point(
    data = df %>%
      filter(
        Species == target_species
      ),
    shape = 21,
    fill = NA,
    color = col_target,
    stroke = 1.2,
    size = 5,
    show.legend = FALSE
  ) +
    
    # --------------------------------------------------------
  # Color scale
  # --------------------------------------------------------
  scale_color_manual(
    name = NULL,
    
    values = my_cols,
    
    limits = group_levels,
    
    breaks = group_levels,
    
    labels = c(
      "Longevity-enriched",
      "Non-longevity",
      "NS"
    ),
    
    drop = FALSE
  ) +
    
    # --------------------------------------------------------
  # Labels
  # --------------------------------------------------------
  labs(
    title = title_text,
    x = "MaAsLin2 coefficient",
    y = NULL
  ) +
    
    coord_cartesian(
      clip = "off"
    ) +
    
    # --------------------------------------------------------
  # Theme
  # --------------------------------------------------------
  theme_classic(
    base_family = "Arial"
  ) +
    
    theme(
      
      text = element_text(
        family = "Arial",
        face = "bold",
        color = "black"
      ),
      
      # Title
      plot.title = element_text(
        family = "Arial",
        size = 20,
        face = "bold",
        hjust = 0.5,
        vjust = 2.5,
        margin = margin(
          b = 12
        )
      ),
      
      # X-axis title
      axis.title.x = element_text(
        family = "Arial",
        size = 16,
        face = "bold",
        margin = margin(
          t = 10
        )
      ),
      
      # X-axis tick labels
      axis.text.x = element_text(
        family = "Arial",
        size = 13,
        face = "bold",
        color = "black"
      ),
      
      # ------------------------------------------------------
      # IMPORTANT:
      # Standard element_text instead of ggtext
      # This keeps species names as ordinary text
      # ------------------------------------------------------
      axis.text.y = element_text(
        family = "Arial",
        size = 12,
        face = "bold",
        color = "black"
      ),
      
      axis.line = element_blank(),
      
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 1.5
      ),
      
      axis.ticks = element_line(
        color = "black",
        linewidth = 1
      ),
      
      # ------------------------------------------------------
      # Legend
      # ------------------------------------------------------
      legend.position = c(
        0.5,
        1.01
      ),
      
      legend.justification = c(
        0.5,
        0
      ),
      
      legend.direction = "horizontal",
      
      legend.box = "horizontal",
      
      legend.text = element_text(
        family = "Arial",
        size = 10.5,
        face = "bold",
        color = "black"
      ),
      
      legend.key = element_blank(),
      
      legend.key.width = unit(
        0.35,
        "cm"
      ),
      
      legend.key.height = unit(
        0.35,
        "cm"
      ),
      
      legend.spacing.x = unit(
        0.08,
        "cm"
      ),
      
      legend.margin = margin(
        t = 0,
        r = 0,
        b = 0,
        l = 0
      ),
      
      plot.margin = margin(
        t = 38,
        r = 15,
        b = 10,
        l = 10
      )
    ) +
    
    guides(
      color = guide_legend(
        override.aes = list(
          size = 4.2,
          alpha = 1
        ),
        nrow = 1,
        byrow = TRUE
      )
    )
}

# ------------------------------------------------------------
#  Create two panels
# ------------------------------------------------------------
