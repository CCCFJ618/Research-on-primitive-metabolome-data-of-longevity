# ============================================================
# Fig.4E
# Genus-level PCoA across 3 regions
# Arial version
# Editable text for Illustrator
# ============================================================

library(dplyr)
library(tidyr)
library(tibble)
library(ggplot2)
library(vegan)
library(ape)


# ------------------------------------------------------------
# Prepare sample metadata
# ------------------------------------------------------------
meta_df <- genus_long_3area %>%
  select(prob, area) %>%
  distinct()

# 简化地区名字
meta_df <- meta_df %>%
  mutate(
    area_plot = case_when(
      area == "Hainan" ~ "Hainan",
      area == "Sardinia (Italy)" ~ "Sardinia",
      area == "Emilia Romagna region (Italy)" ~ "Emilia Romagna",
      TRUE ~ area
    )
  )

# ------------------------------------------------------------
# Convert long table to sample × genus matrix
# ------------------------------------------------------------
abund_df <- genus_long_3area %>%
  select(prob, Genus, Abundance) %>%
  group_by(prob, Genus) %>%
  summarise(
    Abundance = sum(Abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  pivot_wider(
    names_from = Genus,
    values_from = Abundance,
    values_fill = 0
  )

# ------------------------------------------------------------
#  Convert to matrix
# ------------------------------------------------------------
abund_mat <- abund_df %>%
  column_to_rownames("prob") %>%
  as.matrix()

# Ensure numeric
mode(abund_mat) <- "numeric"

# ------------------------------------------------------------
#  Remove zero-sum samples if any
# ------------------------------------------------------------
abund_mat <- abund_mat[
  rowSums(abund_mat) > 0,
  ,
  drop = FALSE
]

# Metadata match
meta_df <- meta_df %>%
  filter(prob %in% rownames(abund_mat)) %>%
  arrange(match(prob, rownames(abund_mat)))

# ------------------------------------------------------------
# Bray-Curtis distance
# ------------------------------------------------------------
bray_dist <- vegdist(
  abund_mat,
  method = "bray"
)

# ------------------------------------------------------------
# PCoA
# ------------------------------------------------------------
pcoa_res <- ape::pcoa(bray_dist)

# Extract first two axes
pcoa_df <- data.frame(
  prob = rownames(pcoa_res$vectors),
  PCoA1 = pcoa_res$vectors[, 1],
  PCoA2 = pcoa_res$vectors[, 2]
)

# Explained variance
var1 <- round(
  pcoa_res$values$Relative_eig[1] * 100,
  2
)

var2 <- round(
  pcoa_res$values$Relative_eig[2] * 100,
  2
)

# Add metadata
pcoa_df <- pcoa_df %>%
  left_join(
    meta_df,
    by = "prob"
  )

# ------------------------------------------------------------
#  PERMANOVA
# ------------------------------------------------------------
set.seed(123)

adonis_res <- adonis2(
  bray_dist ~ area_plot,
  data = meta_df,
  permutations = 999
)

print(adonis_res)

R2_value <- round(
  adonis_res$R2[1],
  3
)

P_value <- adonis_res$`Pr(>F)`[1]

P_label <- ifelse(
  P_value < 0.001,
  "P < 0.001",
  paste0("P = ", signif(P_value, 3))
)

stat_label <- paste0(
  "PERMANOVA\n",
  "R² = ", R2_value,
  "\n",
  P_label
)

# ------------------------------------------------------------
#  Colors
# ------------------------------------------------------------
region_cols <- c(
  "Hainan" = "#4F8F83",
  "Sardinia" = "#D9A66F",
  "Emilia Romagna" = "#7F8FB3"
)

# ------------------------------------------------------------
# 9. PCoA plot
# ------------------------------------------------------------
p_pcoa <- ggplot(
  pcoa_df,
  aes(
    x = PCoA1,
    y = PCoA2,
    color = area_plot,
    fill = area_plot
  )
) +
  
  stat_ellipse(
    geom = "polygon",
    type = "t",
    level = 0.95,
    alpha = 0.15,
    linewidth = 0.9
  ) +
  
  geom_point(
    size = 3.2,
    alpha = 0.85
  ) +
  
  scale_color_manual(
    values = region_cols
  ) +
  
  scale_fill_manual(
    values = region_cols
  ) +
  
  annotate(
    "text",
    x = Inf,
    y = Inf,
    label = stat_label,
    hjust = 1.08,
    vjust = 1.2,
    size = 5,
    fontface = "bold",
    family = "Arial"
  ) +
  
  labs(
    x = paste0("PCoA1 (", var1, "%)"),
    y = paste0("PCoA2 (", var2, "%)"),
    color = NULL,
    fill = NULL
  ) +
  
  theme_classic(
    base_family = "Arial"
  ) +
  
  theme(
    
    text = element_text(
      family = "Arial"
    ),
    
    axis.title = element_text(
      size = 17,
      face = "bold",
      color = "black"
    ),
    
    axis.text = element_text(
      size = 13,
      face = "bold",
      color = "black"
    ),
    
    legend.text = element_text(
      size = 13,
      face = "bold",
      family = "Arial"
    ),
    
    legend.position = c(
      0.18,
      0.90
    ),
    
    axis.line = element_blank(),
    
    panel.border = element_rect(
      color = "black",
      fill = NA,
      linewidth = 1.5
    ),
    
    axis.ticks = element_line(
      linewidth = 1,
      color = "black"
    ),
    
    aspect.ratio = 1
  )

# ------------------------------------------------------------
#  Show
# ------------------------------------------------------------
p_pcoa

# ------------------------------------------------------------
# Export PDF
# Arial
# ------------------------------------------------------------
ggsave(
  filename = "C:/Users/Administrator/Desktop/Fig3B_genus_PCoA.pdf",
  plot = p_pcoa,
  width = 6.5,
  height = 6.5,
  units = "in",
  device = cairo_pdf,
  bg = "white"
)
